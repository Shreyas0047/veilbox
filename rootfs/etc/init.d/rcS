#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

mkdir -p /dev/pts /dev/shm
mount -t devpts none /dev/pts
mount -t tmpfs none /dev/shm

hostname -F /etc/hostname

mkdir -p /mnt/state
# Mount state: prefer external persistent disk (vdb), fall back to VEILBOX /state
if [ -b /dev/vdb ]; then
    mount /dev/vdb /mnt/state 2>/dev/null && echo "mounted /dev/vdb on /mnt/state" \
        || mount -t tmpfs none /mnt/state
elif [ -b /dev/sdb ]; then
    mount /dev/sdb /mnt/state 2>/dev/null && echo "mounted /dev/sdb on /mnt/state" \
        || mount -t tmpfs none /mnt/state
elif mount LABEL=VEILBOX /mnt/state 2>/dev/null; then
    :
else
    mount -t tmpfs none /mnt/state
fi
mkdir -p /mnt/state/containerd /mnt/state/log /mnt/state/volumes

ip link set lo up
ip link set eth0 up 2>/dev/null || true

/sbin/udhcpc -i eth0 -b -q &

/sbin/syslogd -n &

mkdir -p /var/run /var/log

/usr/bin/containerd --config /etc/containerd/config.toml &
/usr/sbin/dropbear -p 22

# Custom OS config fragment for container-only host
# Merge on top of make tinyconfig via scripts/kconfig/merge_config.sh

# Networking core
CONFIG_NET=y

# PCI (needed for virtio-pci on x86)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y

# Virtio bus and transports
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# Virtio block driver
CONFIG_VIRTIO_BLK=y

# Virtio network driver
CONFIG_VIRTIO_NET=y

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# SquashFS filesystem
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_ZLIB=y

# OverlayFS
CONFIG_OVERLAY_FS=y

# tmpfs (required for /tmp, /dev/shm)
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# Virtual memory filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Device filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# TTY layer (required by serial drivers)
CONFIG_TTY=y

# Serial console (8250 UART)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_PCI=y

# Control groups (for containerd/runc)
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_BPF=y

# Namespaces (for containers)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Binary formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Container networking
CONFIG_VETH=y
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m

# ACPI (required by EFI)
CONFIG_ACPI=y

# EFI stub (provides MZ/PE boot header needed for -kernel boot in QEMU)
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Initramfs support
CONFIG_BLK_DEV_INITRD=y

# BPF syscall (needed by containerd for cgroupv2 device)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

# Kernel config defaults
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# 9P networking (optional, for debugging via virtio-9p)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

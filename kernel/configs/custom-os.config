# Custom OS config fragment for container-only host
# Merge on top of make tinyconfig via scripts/kconfig/merge_config.sh

# Networking core
CONFIG_NET=y

# PCI (needed for virtio-pci on x86)
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_DIRECT=y
CONFIG_PCI_MMCONFIG=y

# Virtio bus and transports
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y

# Virtio block driver
CONFIG_VIRTIO_BLK=y

# Virtio network driver
CONFIG_VIRTIO_NET=y

# Bonding driver (for NIC bonding / link aggregation)
CONFIG_BONDING=y

# WireGuard VPN (secure tunnel)
CONFIG_WIREGUARD=y

# Virtio console (for QEMU guest agent)
CONFIG_VIRTIO_CONSOLE=y

# Device mapper (for LUKS/dm-crypt state encryption)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_RNG=y

# Block layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# SquashFS filesystem
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_ZLIB=y

# OverlayFS
CONFIG_OVERLAY_FS=y

# tmpfs (required for /tmp, /dev/shm)
CONFIG_TMPFS=y
CONFIG_SHMEM=y

# Virtual memory filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Device filesystem
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# TTY layer (required by serial drivers)
CONFIG_TTY=y

# Serial console (8250 UART)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250_PCI=y

# Control groups (for containerd/runc)
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_MEMCG_SWAP_ENABLED=y
CONFIG_CGROUP_BPF=y

# Namespaces (for containers)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Binary formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Container networking
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# Netfilter core (iptables, NAT, connection tracking)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_TUN=y

# AppArmor LSM (Mandatory Access Control for containers)
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y

# Kernel hardening
CONFIG_FORTIFY_SOURCE=y
CONFIG_SECURITY_YAMA=y

# Prevent debugfs mounts at runtime (still compiled in for trace selctors)
CONFIG_DEBUG_FS_ALLOW_NONE=y

# LSM order: lockdown protects kernel, then capability/yama/apparmor
CONFIG_LSM="lockdown,capability,yama,apparmor"

# Kernel lockdown + module signing (no unsigned modules)
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"

# nftables (needed by iptables-nft binary on Fedora)
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y

# ACPI (required by EFI)
CONFIG_ACPI=y

# EFI stub (provides MZ/PE boot header needed for -kernel boot in QEMU)
CONFIG_EFI=y
CONFIG_EFI_STUB=y

# Initramfs support
CONFIG_BLK_DEV_INITRD=y

# BPF syscall (needed by containerd for cgroupv2 device)
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y

# Kernel config defaults
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Disable unnecessary attack surface
# CONFIG_DEVMEM is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PROC_KCORE is not set

# 9P networking (optional, for debugging via virtio-9p)
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

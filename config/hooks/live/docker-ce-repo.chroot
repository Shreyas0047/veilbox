#!/bin/sh
set -e

# Add Docker's official GPG key and apt repository
# https://docs.docker.com/engine/install/debian/

DOCKER_GPG_KEY="/usr/share/keyrings/docker.gpg"
DOCKER_REPO="https://download.docker.com/linux/debian"

# Install prerequisites
apt-get install -y ca-certificates curl

# Download and install Docker's GPG key
install -d /usr/share/keyrings
curl -fsSL "$DOCKER_REPO/gpg" -o "$DOCKER_GPG_KEY"
chmod a+r "$DOCKER_GPG_KEY"

# Add the repository
cat > /etc/apt/sources.list.d/docker.list <<EOF
deb [arch=$(dpkg --print-architecture) signed-by=$DOCKER_GPG_KEY] $DOCKER_REPO bookworm stable
EOF

apt-get update

#!/bin/sh
set -e

# Hide Debian-specific launcher from menu (calamares-settings-debian package)
rm -f /usr/share/applications/calamares-install-debian.desktop

# Enable first-boot hardening service
systemctl enable veilbox-firstboot.service 2>/dev/null || true

# Clean up package cache and temporary files
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /tmp/*
rm -rf /var/tmp/*

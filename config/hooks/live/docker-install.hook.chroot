#!/bin/sh
set -e

# Ensure any broken packages don't block apt operations
dpkg --configure -a --force-depends 2>/dev/null || true

ARCH=$(dpkg --print-architecture)

# Install Docker CE manually (not via get.docker.com which has fragile mirror handling)
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list

# Retry apt-get update to handle transient mirror sync issues
for i in 1 2 3; do
  apt-get update >/dev/null 2>&1 && break
  [ "$i" -lt 3 ] && sleep 15
done

apt-get install -y docker-ce docker-ce-cli containerd.io

# Remove Docker apt source to prevent lb build phase from hitting mirror sync issues
rm -f /etc/apt/sources.list.d/docker.list

#!/bin/sh
set -e

TMPDIR=$(mktemp -d)
cd "$TMPDIR"
cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT

# Niri: scrollable-tiling Wayland compositor
NIRI_VERSION="25.06"
NIRI_URL="https://github.com/YaLTeR/niri/releases/download/v${NIRI_VERSION}/niri-${NIRI_VERSION}-x86_64-linux-gnu.tar.xz"
curl -fsSL "$NIRI_URL" | tar xJ
mv niri /usr/local/bin/niri
chmod +x /usr/local/bin/niri

# Noctalia: minimal Wayland shell for Niri
NOCTALIA_VERSION="0.1.0"
NOCTALIA_DEB="noctalia_${NOCTALIA_VERSION}_amd64.deb"
NOCTALIA_URL="https://github.com/noctalia/shell/releases/download/v${NOCTALIA_VERSION}/${NOCTALIA_DEB}"
curl -fsSLO "$NOCTALIA_URL"
apt-get install -y ./"$NOCTALIA_DEB"

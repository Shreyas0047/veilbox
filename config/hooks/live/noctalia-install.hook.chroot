#!/bin/sh
set -e

# Niri: scrollable-tiling Wayland compositor
NIRI_VERSION="26.04"
NIRI_URL="https://github.com/niri-wm/niri/releases/download/v${NIRI_VERSION}/niri-${NIRI_VERSION}-x86_64-linux-gnu.tar.xz"
curl -fsSL "$NIRI_URL" | tar xJ -C /usr/local/bin --no-same-owner
chmod +x /usr/local/bin/niri

# Noctalia: minimal Wayland shell
curl -fsSL https://pkg.noctalia.dev/gpg.key | gpg --dearmor -o /etc/apt/keyrings/noctalia.gpg
echo "deb [signed-by=/etc/apt/keyrings/noctalia.gpg] https://pkg.noctalia.dev/apt trixie main" > /etc/apt/sources.list.d/noctalia.list
apt-get update -qq
apt-get install -y -qq noctalia

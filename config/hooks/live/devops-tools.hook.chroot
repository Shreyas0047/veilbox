#!/bin/sh
set -e

TOOLS_DIR="/usr/local/bin"
TMPDIR=$(mktemp -d)
cd "$TMPDIR"
cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT

ARCH="amd64"

try_install() {
    local name="$1"
    shift
    echo "==> Installing $name..."
    "$@" || echo "  [WARN] $name installation skipped"
}

download_gh_release() {
    local repo="$1"
    local pattern="$2"
    local output="$3"
    local version="${4:-latest}"

    local url
    if [ "$version" = "latest" ]; then
        url=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" \
            | grep "browser_download_url.*${pattern}" \
            | head -1 \
            | cut -d: -f2- \
            | tr -d ' "')
    else
        url="https://github.com/${repo}/releases/download/v${version}/${pattern}"
    fi

    [ -z "$url" ] && return 1

    curl -fsSL "$url" -o "download"
    case "$url" in
        *.tar.gz)
            tar xzf "download" -C "$TOOLS_DIR" "$output" 2>/dev/null \
                || { tar xzf "download" && cp "$output" "$TOOLS_DIR/" 2>/dev/null; true; }
            ;;
        *.gz)
            gunzip -c "download" > "$TOOLS_DIR/$output"
            ;;
        *)
            cp "download" "$TOOLS_DIR/$output"
            ;;
    esac
    chmod +x "$TOOLS_DIR/$output" 2>/dev/null || true
    echo "  $name installed"
}

# kubectl
try_install "kubectl" download_gh_release "kubernetes/kubernetes" \
    "linux-${ARCH}/kubectl" "kubectl" \
    "$(curl -fsSL https://cdn.dl.k8s.io/release/stable.txt | sed 's/^v//')"

# Helm
try_install "helm" download_gh_release "helm/helm" "linux-${ARCH}.tar.gz" "helm"

# yq
try_install "yq" download_gh_release "mikefarah/yq" "linux_${ARCH}.tar.gz" "yq"

# dive
try_install "dive" download_gh_release "wagoodman/dive" "linux_${ARCH}.tar.gz" "dive"

# trivy
try_install "trivy" download_gh_release "aquasecurity/trivy" "Linux-${ARCH}.tar.gz" "trivy"

# k9s
try_install "k9s" download_gh_release "derailed/k9s" "Linux_${ARCH}.tar.gz" "k9s"

# stern
try_install "stern" download_gh_release "stern/stern" "linux_${ARCH}.tar.gz" "stern"

# kind
try_install "kind" download_gh_release "kubernetes-sigs/kind" "linux-${ARCH}" "kind"

# minikube
try_install "minikube" download_gh_release "kubernetes/minikube" "linux-${ARCH}" "minikube"

# kustomize
try_install "kustomize" download_gh_release "kubernetes-sigs/kustomize" "linux_${ARCH}.tar.gz" "kustomize"

# argocd
try_install "argocd" download_gh_release "argoproj/argo-cd" "linux-${ARCH}" "argocd"

# Terraform (HashiCorp apt repo)
try_install "terraform" sh -c "
    curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg 2>/dev/null
    echo 'deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com bookworm main' > /etc/apt/sources.list.d/hashicorp.list
    apt-get update -qq 2>/dev/null && apt-get install -y -qq terraform 2>/dev/null
"

# GitHub CLI (Debian repo)
try_install "gh" sh -c "
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    echo 'deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main' > /etc/apt/sources.list.d/github-cli.list
    apt-get update -qq 2>/dev/null && apt-get install -y -qq gh 2>/dev/null
"

# AWS CLI v2
try_install "aws" sh -c "
    curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o awscliv2.zip
    unzip -q awscliv2.zip 2>/dev/null
    ./aws/install 2>/dev/null
    rm -rf aws awscliv2.zip
"

# Azure CLI (Microsoft repo)
try_install "azure-cli" sh -c "
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg 2>/dev/null
    echo 'deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/repos/azure-cli bookworm main' > /etc/apt/sources.list.d/azure-cli.list
    apt-get update -qq 2>/dev/null && apt-get install -y -qq azure-cli 2>/dev/null
"

# Google Cloud CLI
try_install "gcloud" sh -c "
    echo 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' > /etc/apt/sources.list.d/google-cloud-sdk.list
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg 2>/dev/null
    apt-get update -qq 2>/dev/null && PYTHONHASHSEED=0 apt-get install -y -qq google-cloud-sdk 2>/dev/null
"

# Recover dpkg from any partial installs
dpkg --configure -a 2>/dev/null || true

# Cleanup
apt-get clean -qq 2>/dev/null || true

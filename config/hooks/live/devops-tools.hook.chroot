#!/bin/sh
set -e

TOOLS_DIR="/usr/local/bin"
TMPDIR=$(mktemp -d)
cd "$TMPDIR"
cleanup() { rm -rf "$TMPDIR"; }
trap cleanup EXIT

ARCH="amd64"

try_install() {
    local name="$1"
    shift
    echo "==> Installing $name..."
    "$@" || echo "  [WARN] $name installation skipped"
}

download_gh_release() {
    local repo="$1"
    local pattern="$2"
    local output="$3"
    local version="${4:-latest}"

    local url
    local ua="Veilbox/2.0"
    if [ "$version" = "latest" ]; then
        # GitHub API returns single-line JSON; use grep -o to extract URL value
        url=$(curl -fsSL -H "User-Agent: ${ua}" "https://api.github.com/repos/${repo}/releases/latest" \
            | grep -o '"browser_download_url":"[^"]*"' \
            | grep "${pattern}" \
            | head -1 \
            | cut -d'"' -f4)
    else
        url="https://github.com/${repo}/releases/download/v${version}/${pattern}"
    fi

    [ -z "$url" ] && return 1

    curl -fsSL --connect-timeout 15 --max-time 120 "$url" -o "download"
    case "$url" in
        *.tar.gz)
            if tar xzf "download" -C "$TOOLS_DIR" "$output" 2>/dev/null; then
                : # exact extraction succeeded
            else
                tar xzf "download" 2>/dev/null
                find . -name "$output" -type f -exec cp {} "$TOOLS_DIR/" \; 2>/dev/null
                if [ ! -f "$TOOLS_DIR/$output" ]; then
                    _best="" _best_sz=0
                    for _f in $(find . -type f 2>/dev/null); do
                        _sz=$(stat -c%s "$_f" 2>/dev/null || echo 0)
                        if [ "$_sz" -gt "$_best_sz" ] 2>/dev/null; then
                            _best="$_f"; _best_sz=$_sz
                        fi
                    done
                    [ -n "$_best" ] && cp "$_best" "$TOOLS_DIR/$output" 2>/dev/null
                fi
            fi || true
            ;;
        *.gz)
            gunzip -c "download" > "$TOOLS_DIR/$output"
            ;;
        *)
            cp "download" "$TOOLS_DIR/$output"
            ;;
    esac
    chmod +x "$TOOLS_DIR/$output" 2>/dev/null || true
    if [ -f "$TOOLS_DIR/$output" ]; then
        echo "  $name installed"
    else
        echo "  [WARN] $name extraction failed"
        return 1
    fi
}

# kubectl (download binary from dl.k8s.io — GitHub releases don't include binaries)
try_install "kubectl" sh -c '
    _ver=$(curl -fsSL --max-time 10 "https://github.com/kubernetes/kubernetes/releases/latest" 2>/dev/null | grep -o "v[0-9]*\.[0-9]*\.[0-9]*" | head -1 | sed "s/^v//")
    [ -z "$_ver" ] && _ver="1.36.2"
    curl -fsSL --connect-timeout 15 --max-time 120 "https://dl.k8s.io/release/v${_ver}/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl 2>/dev/null || \
    curl -fsSL --connect-timeout 15 --max-time 120 "https://dl.k8s.io/release/stable.txt/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl 2>/dev/null
    chmod +x /usr/local/bin/kubectl 2>/dev/null
    [ -f /usr/local/bin/kubectl ]
'

# Helm (direct download — GitHub release assets don't include the binary tarball)
try_install "helm" sh -c '
    _ver=$(curl -fsSL --max-time 10 "https://github.com/helm/helm/releases/latest" 2>/dev/null | grep -o "v[0-9]*\.[0-9]*\.[0-9]*" | head -1)
    [ -z "$_ver" ] && _ver="v4.2.2"
    curl -fsSL --connect-timeout 15 --max-time 120 "https://get.helm.sh/helm-${_ver}-linux-amd64.tar.gz" -o /tmp/helm.tar.gz
    mkdir -p /tmp/helm-extract
    tar xzf /tmp/helm.tar.gz -C /tmp/helm-extract linux-amd64/helm 2>/dev/null || tar xzf /tmp/helm.tar.gz -C /tmp/helm-extract 2>/dev/null
    cp /tmp/helm-extract/linux-amd64/helm /usr/local/bin/helm 2>/dev/null || cp /tmp/helm-extract/helm /usr/local/bin/helm 2>/dev/null
    chmod +x /usr/local/bin/helm 2>/dev/null
    rm -rf /tmp/helm.tar.gz /tmp/helm-extract
    [ -f /usr/local/bin/helm ]
'

# yq
try_install "yq" download_gh_release "mikefarah/yq" "linux_${ARCH}.tar.gz" "yq"

# dive
try_install "dive" download_gh_release "wagoodman/dive" "linux_${ARCH}.tar.gz" "dive"

# k9s
try_install "k9s" download_gh_release "derailed/k9s" "Linux_${ARCH}.tar.gz" "k9s"

# stern
try_install "stern" download_gh_release "stern/stern" "linux_${ARCH}.tar.gz" "stern"

# kind
try_install "kind" download_gh_release "kubernetes-sigs/kind" "linux-${ARCH}" "kind"

# kustomize
try_install "kustomize" download_gh_release "kubernetes-sigs/kustomize" "linux_${ARCH}.tar.gz" "kustomize"

# Terraform (HashiCorp apt repo)
try_install "terraform" sh -c "
    curl -fsSL https://apt.releases.hashicorp.com/gpg | gpg --dearmor -o /usr/share/keyrings/hashicorp.gpg 2>/dev/null
    echo 'deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com bookworm main' > /etc/apt/sources.list.d/hashicorp.list
    apt-get update -qq 2>/dev/null && apt-get install -y -qq terraform 2>/dev/null
"

# GitHub CLI (Debian repo)
try_install "gh" sh -c "
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null
    echo 'deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main' > /etc/apt/sources.list.d/github-cli.list
    apt-get update -qq 2>/dev/null && apt-get install -y -qq gh 2>/dev/null
"

# AWS CLI v2
try_install "aws" sh -c "
    curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o awscliv2.zip
    unzip -q awscliv2.zip 2>/dev/null
    ./aws/install 2>/dev/null
    rm -rf aws awscliv2.zip
"

# Google Cloud CLI (disabled: Python postinst needs /dev/urandom which is unavailable in
# debootstrap chroot; even mknod + mount --bind don't work in this environment)
# try_install "gcloud" sh -c "
#     echo 'deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main' > /etc/apt/sources.list.d/google-cloud-sdk.list
#     curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg 2>/dev/null
#     apt-get update -qq 2>/dev/null
#     DEBIAN_FRONTEND=noninteractive apt-get install -y -qq google-cloud-cli 2>/dev/null || true
# "

# Purge any broken gcloud packages that might block apt in subsequent hooks
dpkg --purge --force-depends google-cloud-cli google-cloud-sdk 2>/dev/null || true
dpkg --configure -a --force-depends 2>/dev/null || true

# Cleanup
apt-get clean -qq 2>/dev/null || true

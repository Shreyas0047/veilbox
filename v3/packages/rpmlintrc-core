# rpmlint configuration for veilbox-core.
# Run with: rpmlint -r packages/rpmlintrc-core <core rpm>

# Go binaries are statically linked and unstripped by design (the Go
# toolchain embeds DWARF; split debuginfo is deferred, see
# veilbox-core.spec).
addFilter("statically-linked-binary")
addFilter("unstripped-binary-or-object")

# The veil binary ships no manual page yet (prototype).
addFilter("no-manual-page-for-binary")

# Core carries no standalone documentation directory.
addFilter("no-documentation")

// {{.DisplayName}} — Veilbox-generated Niri configuration.
// Created by 'veil environment install {{.Name}}' on first touch.
// You own this file afterwards — edit it freely.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    center-focused-column "always"
    focus-ring {
        width 3
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
    place-within-backdrop true
}

spawn-at-startup "noctalia"

binds {
    Mod+Shift+Q { close-window; }
    Mod+T { spawn "{{.Terminal}}"; }
    Mod+E { spawn "{{.Terminal}}" "-e" "{{.Editor}}"; }
    Mod+D { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+C { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    Print { spawn-sh "mkdir -p \"$HOME/Pictures\" && grim -g \"$(slurp)\" \"$HOME/Pictures/screenshot-$(date +%F-%T).png\""; }
    XF86AudioRaiseVolume { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute { spawn-sh "noctalia msg volume-mute"; }
}
